/*
 * gallery.logo
 *
 * A feature-rich MiniLogo program used to benchmark the language server.
 * It exercises parameterized definitions, nested macro calls, parameter
 * references, arithmetic expressions, colors, and for-loops so that hover,
 * definition, references, rename, completion, and formatting all have
 * meaningful targets throughout the document.
 */

// low-level primitives: each draws a shape from its parameters

def dot(x, y) {
    pen(up)
    move(x, y)
    pen(down)
    move(0, 0)
    pen(up)
}

def segment(x, y, len) {
    pen(up)
    move(x, y)
    pen(down)
    move(len, 0)
    move(0, len)
    pen(up)
}

def square(x, y, size) {
    pen(up)
    move(x, y)
    pen(down)
    move(size, 0)
    move(0, size)
    move(-1 * size, 0)
    move(0, -1 * size)
    pen(up)
    move(-1 * x, -1 * y)
}

def rect(x, y, w, h) {
    pen(up)
    move(x, y)
    pen(down)
    move(w, 0)
    move(0, h)
    move(-1 * w, 0)
    move(0, -1 * h)
    pen(up)
}

def triangle(x, y, base) {
    pen(up)
    move(x, y)
    pen(down)
    move(base, 0)
    move(-1 * (base / 2), base)
    move(-1 * (base / 2), -1 * base)
    pen(up)
}

// composites: built by calling the primitives above

def grid(ox, oy, cell, count) {
    for i = 0 to count {
        for j = 0 to count {
            square(ox + i * cell, oy + j * cell, cell)
        }
    }
}

def frieze(ox, oy, unit, count) {
    for k = 0 to count {
        rect(ox + k * unit, oy, unit, unit / 2)
        triangle(ox + k * unit, oy + unit, unit)
    }
}

def burst(cx, cy, spread) {
    for a = 0 to spread {
        dot(cx + a, cy + a)
        dot(cx - a, cy + a)
        dot(cx + a, cy - a)
        dot(cx - a, cy - a)
    }
}

def fan(cx, cy, len, blades) {
    for b = 0 to blades {
        segment(cx, cy, len + b * 2)
    }
}

// scene tiles: a large gallery, each tile composes the shapes above.
// colors vary per tile to keep the arithmetic and color paths busy.

def tile0(x, y) {
    color(32, 32, 64)
    grid(x, y, 10, 2)
    frieze(x + 10, y + 10, 10, 3)
    burst(x + 20, y + 10, 4)
}

