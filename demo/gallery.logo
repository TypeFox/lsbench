// lay the whole gallery out in a grid of tiles
def gallery(cols, rows, gap) {
    for c = 0 to cols {
        for r = 0 to rows {
            tile0(c * gap + 0, r * gap)
            tile1(c * gap + 4, r * gap)
            tile2(c * gap + 8, r * gap)
            tile3(c * gap + 12, r * gap)
            tile4(c * gap + 16, r * gap)
            tile5(c * gap + 20, r * gap)
            tile6(c * gap + 24, r * gap)
            tile7(c * gap + 28, r * gap)
        }
    }
}

// top-level program: set a pen, then render everything
pen(up)
move(0, 0)
color(16, 16, 32)
gallery(6, 6, 120)

// a few direct top-level tile calls for good measure
tile0(0, 0)
