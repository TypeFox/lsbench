{
  "name": "lsbench",
  "version": "0.0.1",
  "description": "Benchmark arbitrary language servers with scripted LSP actions",
  "license": "MIT",
  "bin": {
    "lsbench": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "lint": "biome check src && oxlint src",
    "lint:fix": "biome check --write src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^20.14.0",
    "oxlint": "^1.60.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
